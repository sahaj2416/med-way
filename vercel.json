{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**",
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/driver", "destination": "/driver.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
